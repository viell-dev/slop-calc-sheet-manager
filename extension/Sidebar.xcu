<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="SheetManagerDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">{{Sheet Manager}}</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>SheetManagerDeck</value></prop>
        <prop oor:name="IconURL" oor:type="xs:string"><value>%origin%/icons/deck.svg</value></prop>
        <prop oor:name="HighContrastIconURL" oor:type="xs:string"><value>%origin%/icons/deck.svg</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">Calc, any, visible ;</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>500</value></prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="SheetManagerPanel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">{{Sheet Manager}}</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>SheetManagerPanel</value></prop>
        <prop oor:name="DeckId" oor:type="xs:string"><value>SheetManagerDeck</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">Calc, any, visible ;</value></prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string"><value>private:resource/toolpanel/SheetManager/Panel</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>100</value></prop>
        <prop oor:name="TitleBarIsOptional" oor:type="xs:boolean"><value>true</value></prop>
        <prop oor:name="ShowForReadOnlyDocument" oor:type="xs:boolean"><value>true</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
